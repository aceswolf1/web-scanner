{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "ANTHROPIC_BASE_URL": "",
    "ANTHROPIC_AUTH_TOKEN": "",
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-oppus-4-8",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "ANTHROPIC_TIMEOUT": "300000",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "true",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_PLUGIN_ENABLE_QUESTION_RULES": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_COMMAND": "/Users/cace/.local/bin/claude-minimax-wrapper"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_screenshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_wait",
      "mcp__browsermcp__browser_snapshot",
      "mcp__browsermcp__browser_screenshot",
      "mcp__browsermcp__browser_click",
      "mcp__browsermcp__browser_press_key",
      "mcp__browsermcp__browser_type",
      "mcp__browsermcp__browser_navigate",
      "mcp__browsermcp__browser_wait",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:github.com/anthropics)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:aws.amazon.com)",
      "mcp__google-search__search",
      "mcp__google-search__read_webpage",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_close",
      "mcp__ide__getDiagnostics",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_install"
    ],
    "deny": ["WebSearch"]
  },
  "model": "claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/claude-utilities/status-var.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "plansDirectory": "./context/plans",
  "outputStyle": "default"
}
