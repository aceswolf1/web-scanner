# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://webscanner:webscanner@db:5432/webscanner
POSTGRES_DB=webscanner
POSTGRES_USER=webscanner
POSTGRES_PASSWORD=webscanner

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
PORT=4000

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=web-scanner-images
# Public URL returned to the browser after image upload (not the Docker service name)
MINIO_PUBLIC_URL=http://localhost:9000

# ── eBay Browse API (optional — enables eBay adapter without HTML scraping) ──
# From developer.ebay.com: App ID, Cert ID (secret), Dev ID (optional)
EBAY_APP_ID=
EBAY_CERTID=
EBAY_DEVID=
EBAY_ENV=production

# ── Mercado Libre (optional — catalog/item prices without HTML scraping) ─────
ML_APP_ID=
ML_CLIENT_SECRET=
ML_SITE_ID=MCO
# Optional pre-issued token (skips client_credentials):
# ML_ACCESS_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_URL=http://localhost:4000
NUXT_PUBLIC_STORAGE_URL=http://localhost:9000