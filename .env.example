# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://webscanner:webscanner@db:5432/webscanner
POSTGRES_DB=webscanner
POSTGRES_USER=webscanner
POSTGRES_PASSWORD=webscanner

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
PORT=4000

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
